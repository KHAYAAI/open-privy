{
  "name": "openprivy",
  "version": "0.1.0",
  "description": "Open-source Privy alternative: embedded wallet + auth for Africa",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "services/*",
    "sdks/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "dependencies": {},
  "devDependencies": {
    "turbo": "^2.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.3.0"
  },
  "packageManager": "npm@10.0.0",
  "overrides": {
    "multer": "^2.5.0",
    "lodash": "^4.18.1",
    "postcss": "^8.5.32",
    "next": {
      "postcss": "^8.5.32"
    }
  }
}
