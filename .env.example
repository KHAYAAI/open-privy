# Supabase Configuration
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=eyJhbGc...
SUPABASE_JWT_SECRET=your-jwt-secret-change-in-production

# Blockchain RPC URLs
ETHEREUM_RPC_MAINNET=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
ETHEREUM_RPC_SEPOLIA=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
ETHEREUM_RPC_ARBITRUM=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
ETHEREUM_RPC_POLYGON=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
SOLANA_RPC_MAINNET=https://solana-mainnet.g.alchemy.com/v2/YOUR_KEY
SOLANA_RPC_DEVNET=https://api.devnet.solana.com

# Alchemy API Key (for balance/history lookups)
ALCHEMY_API_KEY=your-alchemy-key

# Pimlico (Gas Sponsorship)
PIMLICO_API_KEY=your-pimlico-key
PIMLICO_ENDPOINT=https://api.pimlico.io/v2

# Account Abstraction
ENTRYPOINT_ADDRESS=0x0000000071727De22E5E9d8BAf0edAc6f37da032
ACCOUNT_FACTORY_ADDRESS=0x0000000071727De22E5E9d8BAf0edAc6f37da032

# Database
DATABASE_URL=postgresql://app:dev-only@localhost:5432/openprivy
REDIS_URL=redis://localhost:6379

# Backend
API_URL=http://localhost:3001
NODE_ENV=development
LOG_LEVEL=debug
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRATION=24h

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...

# Monitoring & Analytics
SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Mobile / Expo
EXPO_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...

# Security
ENCRYPTION_KEY=your-encryption-key-32-chars-minimum
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Feature Flags
ENABLE_GAS_SPONSORSHIP=true
ENABLE_SOCIAL_RECOVERY=true
ENABLE_MOBILE_APP=true
